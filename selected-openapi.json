{
  "openapi": "3.1.0",
  "info": {
    "title": "WooCommerce selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://{WOOCOMMERCE_HOST}/wp-json/wc/v3",
      "variables": {
        "WOOCOMMERCE_HOST": {
          "default": "your-account.example.com",
          "description": "Replace with your own authorized provider account value."
        }
      }
    }
  ],
  "paths": {
    "/customers": {
      "get": {
        "operationId": "woocommerce_list_customers",
        "summary": "woocommerce list customers",
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "woocommerce_create_customer",
        "summary": "woocommerce create customer",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "woocommerce_get_customer",
        "summary": "woocommerce get customer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
